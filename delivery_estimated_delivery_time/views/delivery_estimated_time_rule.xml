<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="delivery_estimated_time_rule_view_tree" model="ir.ui.view">
        <field name="name">delivery.estimated.time.rule.tree</field>
        <field name="model">delivery.estimated.time.rule</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="country_id" />
                <field name="base_min_days" />
                <field name="base_max_days" />
                <field name="active" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="delivery_estimated_time_rule_view_form" model="ir.ui.view">
        <field name="name">delivery.estimated.time.rule.form</field>
        <field name="model">delivery.estimated.time.rule</field>
        <field name="arch" type="xml">
            <form string="Estimated Delivery Time Rule">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="country_id" />
                        </group>
                        <group>
                            <field name="base_min_days" />
                            <field name="base_max_days" />
                            <field name="active" widget="boolean_toggle" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="delivery_estimated_time_rule_action" model="ir.actions.act_window">
        <field name="name">Estimated Delivery Times</field>
        <field name="res_model">delivery.estimated.time.rule</field>
        <field name="view_mode">tree,form</field>
    </record>


    <menuitem
        id="menu_delivery_estimated_time_rule"
        name="Estimated Delivery Times"
        parent="sale.menu_sale_config"
        action="delivery_estimated_time_rule_action"
        sequence="45"
    />


</odoo>
