<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="delivery_estimated_time_exceptions_view_tree" model="ir.ui.view">
        <field name="name">delivery.estimated.time.exceptions.tree</field>
        <field name="model">delivery.estimated.time.exceptions</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="days" />
                <field name="active" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="delivery_estimated_time_exceptions_view_form" model="ir.ui.view">
        <field name="name">delivery.estimated.time.exceptions.form</field>
        <field name="model">delivery.estimated.time.exceptions</field>
        <field name="arch" type="xml">
            <form string="Estimated Delivery Time Exception">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="days" />
                            <field name="active" widget="boolean_toggle" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record
        id="delivery_estimated_time_exceptions_action"
        model="ir.actions.act_window"
    >
        <field name="name">Estimated Delivery Time Exceptions</field>
        <field name="res_model">delivery.estimated.time.exceptions</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_delivery_estimated_time_exceptions"
        name="Estimated Delivery Time Exceptions"
        parent="sale.menu_sale_config"
        action="delivery_estimated_time_exceptions_action"
        sequence="46"
    />
</odoo>
