<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="deliver_carrier_price_with_tax">
        <field name="name">delivery_carrier_price_with_tax</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='destination']" position="after">
                <page string="Automation" name="automation">
                    <group string="Picking order" name="picking_order_automation">
                        <field name="picking_order_autoadd_services_gls_finland_service_ids" widget="many2many_tags" />
                        <field name="picking_order_autoadd_if_customer_email_services_gls_finland_service_ids" widget="many2many_tags" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
