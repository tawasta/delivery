<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_delivery_carrier_form_shipit" model="ir.ui.view">
        <field name="name">delivery.carrier.form.provider.shipit</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='destination']" position="before">
                <page
                    string="ShipIT"
                    name="shipit_configuration"
                    invisible="shipit_service_code == False"
                >
                    <group name="shipit">
                        <field name="shipit_service_code" />
                        <field name="shipit_require_pickup_point" />
                        <field
                            name="shipit_allowed_package_type_ids"
                            domain="[('package_carrier_type', '=', delivery_type)]"
                            widget="many2many_tags"
                        />
                        <field
                            name="shipit_allowed_additional_service_ids"
                            widget="many2many_tags"
                        />
                        <field
                            name="shipit_default_additional_service_ids"
                            domain="[('id', 'in', shipit_allowed_additional_service_ids)]"
                            widget="many2many_tags"
                        />
                    </group>
                    <group name="shipit_dimensions" string="Default dimensions">
                        <field
                            name="shipit_use_default_dimensions"
                            widget="boolean_toggle"
                        />
                        <field
                            name="shipit_default_length_cm"
                            invisible="not shipit_use_default_dimensions"
                        />
                        <field
                            name="shipit_default_width_cm"
                            invisible="not shipit_use_default_dimensions"
                        />
                        <field
                            name="shipit_default_height_cm"
                            invisible="not shipit_use_default_dimensions"
                        />
                    </group>
                    <!-- Not currently used, but keep for future use
                    <group name="shipit_advanced_api" string="Advanced API settings">
                    </group>
                    -->
                </page>
            </xpath>
        </field>
    </record>

</odoo>
