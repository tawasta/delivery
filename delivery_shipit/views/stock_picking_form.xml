<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_withcarrier_out_form_shipit" model="ir.ui.view">
        <field name="name">stock.picking.view.form.shipit.shipments</field>
        <field name="model">stock.picking</field>
        <field
            name="inherit_id"
            ref="stock_delivery.view_picking_withcarrier_out_form"
        />
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="shipit_is_carrier" invisible="1" />
                <field
                    name="shipit_shipment_id"
                    readonly="state == 'done'"
                    invisible="not shipit_is_carrier and not shipit_shipment_id"
                />
                <field
                    name="shipit_tracking_codes"
                    readonly="state == 'done'"
                    invisible="not shipit_is_carrier and not shipit_tracking_codes"
                />
                <field
                    name="shipit_tracking_url"
                    readonly="1"
                    invisible="not shipit_is_carrier and not shipit_tracking_url"
                />
                <field
                    name="shipit_label_attachment_id"
                    readonly="1"
                    options="{'no_create': True}"
                    invisible="not shipit_is_carrier and not shipit_label_attachment_id"
                />
                <field
                    name="shipit_last_error"
                    readonly="1"
                    invisible="not shipit_is_carrier and not shipit_last_error"
                />
                <field
                    name="shipit_payload"
                    readonly="1"
                    invisible="not shipit_is_carrier and not shipit_payload"
                />
                <field
                    name="shipit_response"
                    readonly="1"
                    invisible="not shipit_is_carrier and not shipit_response"
                />
            </field>
        </field>
    </record>
</odoo>
