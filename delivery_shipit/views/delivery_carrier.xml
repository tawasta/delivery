<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_delivery_carrier_form_shipit" model="ir.ui.view">
        <field name="name">delivery.carrier.form.provider.shipit</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='destination']" position="before">
                <page
                    string="ShipIT"
                    name="shipit_configuration"
                    invisible="delivery_type != 'shipit'"
                >
                    <group name="shipit">
                        <field
                            name="shipit_api_key"
                            password="1"
                            required="delivery_type == 'shipit'"
                        />
                        <field
                            name="shipit_reseller_id"
                            required="delivery_type == 'shipit'"
                            invisible="1"
                        />
                        <field
                            name="shipit_service_option_ids"
                            widget="many2many_tags"
                            options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                            required="delivery_type == 'shipit'"
                        />
                        <field name="shipit_service_code" invisible="1" />
                        <field name="shipit_require_pickup_point" />
                    </group>
                    <group name="shipit_default_dimensions" string="Default dimensions">
                        <field name="shipit_default_length_cm" />
                        <field name="shipit_default_width_cm" />
                        <field name="shipit_default_height_cm" />
                    </group>
                    <!-- Not currently used, but keep for future use
                    <group name="shipit_advanced_api" string="Advanced API settings">
                    </group>
                    -->
                </page>
            </xpath>
        </field>
    </record>

</odoo>
