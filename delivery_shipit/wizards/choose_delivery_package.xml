<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="choose_delivery_package_view_form" model="ir.ui.view">
        <field name="name">choose.delivery.package.form.shipit</field>
        <field name="model">choose.delivery.package</field>
        <field
            name="inherit_id"
            ref="stock_delivery.choose_delivery_package_view_form"
        />
        <field name="arch" type="xml">

            <field name="delivery_package_type_id" position="before">
                <field
                    name="allowed_package_type_ids"
                    readonly="1"
                    widget="many2many_tags"
                />
            </field>

            <field name="delivery_package_type_id" position="attributes">
                <attribute
                    name="domain"
                >[('id', 'in', allowed_package_type_ids)]</attribute>
            </field>

        </field>
    </record>

</odoo>
