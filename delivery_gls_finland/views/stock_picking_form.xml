<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_withcarrier_out_form" model="ir.ui.view">
        <field name="name">stock.picking.view.form.gls.finland.shipments</field>
        <field name="model">stock.picking</field>
        <field
            name="inherit_id"
            ref="stock_delivery.view_picking_withcarrier_out_form"
        />
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field
                    name="contents"
                    invisible="not carrier_id"
                    readonly="state == 'done'"
                />
                <field
                    name="shipment_info"
                    invisible="not carrier_id"
                    readonly="state == 'done'"
                />
                <field
                    name="parcels"
                    invisible="not carrier_id"
                    readonly="state == 'done'"
                />
                <field name="gls_finland_uuid" invisible="1" />
                <field
                    name="gls_finland_service_ids"
                    invisible="not carrier_id"
                    readonly="state == 'done'"
                    widget="many2many_tags"
                />
                <field
                    name="gls_finland_tracking_codes"
                    invisible="not gls_finland_tracking_codes"
                    readonly="state == 'done'"
                />
            </field>
        </field>
    </record>
</odoo>
