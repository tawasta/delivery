<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_shipit_pickup_point_wizard" model="ir.ui.view">
    <field name="name">shipit.pickup.point.wizard.form</field>
    <field name="model">shipit.pickup.point.wizard</field>
    <field name="arch" type="xml">
      <form string="Shipit pickup point search">
        <field name="picking_id" invisible="1" />
        <group>
          <field name="postcode" />
          <field name="point_type" />
        </group>
        <button
          name="action_search_points"
          string="Search"
          type="object"
          icon="fa-search"
          class="btn-primary"
        />
        <field name="line_ids" nolabel="1" readonly="1">
          <list create="0" delete="0" edit="0" default_order="distance_kilometers asc">
            <button
              name="action_select_point"
              string="Select"
              type="object"
              class="btn-link"
            />
            <field name="point_id" />
            <field name="name" />
            <field name="address" />
            <field name="zipcode" />
            <field name="city" />
            <field name="service_name" />
            <field name="distance_kilometers" />
          </list>
        </field>
        <footer />
      </form>
    </field>
  </record>
</odoo>
