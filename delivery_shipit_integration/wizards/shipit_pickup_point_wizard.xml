<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_shipit_pickup_point_wizard" model="ir.ui.view">
        <field name="name">shipit.pickup.point.wizard.form</field>
        <field name="model">shipit.pickup.point.wizard</field>
        <field name="arch" type="xml">
            <form string="Shipit pickup point search">
                <field name="picking_id" invisible="1" />

                <group string="Search parameters">
                    <field name="postcode" />
                    <!-- TODO: service options seem pointless/redundant
                    <field name="available_service_option_ids" invisible="1" />
                    <field
                        name="service_option_ids"
                        widget="many2many_tags"
                        domain="[('id', 'in', available_service_option_ids)]"
                        options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                    />
                     -->
                    <field name="point_type" />
                    <field
                        name="selected_line_id"
                        readonly="1"
                        invisible="not selected_line_id"
                    />
                    <button
                        name="action_search_points"
                        string="Search"
                        type="object"
                        icon="fa-search"
                        class="btn-primary"
                        colspan="2"
                    />
                </group>

                <div class="oe_title">
                    <h4>Search results</h4>
                </div>
                <group>
                    <field
                        name="search_count"
                        readonly="1"
                        invisible="search_count == 0"
                    />
                    <label
                        for="search_count"
                        string="No results found!"
                        invisible="search_count != 0"
                        class="text-danger"
                    />
                </group>
                <field
                    name="line_ids"
                    nolabel="1"
                    invisible="search_count == 0"
                    readonly="1"
                >
                    <tree create="0" delete="0" edit="0">
                        <button
                            name="action_select_point"
                            string="Select"
                            type="object"
                            class="btn-link"
                        />
                        <field name="point_id" />
                        <field name="name" />
                        <field name="address" />
                        <field name="zipcode" />
                        <field name="city" />
                        <field name="service_name" />
                        <field name="distance_kilometers" />
                    </tree>
                </field>

                <footer>
                    <button
                        name="action_apply_selected_point"
                        string="Use selected pickup point"
                        type="object"
                        class="btn-success"
                        invisible="not selected_line_id"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
