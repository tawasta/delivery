<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_company_form_delivery_shipit_integration" model="ir.ui.view">
        <field name="name">res.company.form.delivery.shipit.integration</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Shipit Settings" name="shipit_settings">
                    <group>
                    <field name="shipit_api_key" />
                    <field name="shipit_environment" />
                    <field name="shipit_timeout_seconds" />
                    </group>
                    <group>
                    <button
                            name="action_shipit_sync_shipping_methods"
                            type="object"
                            string="Sync Shipit services"
                        />
                </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
