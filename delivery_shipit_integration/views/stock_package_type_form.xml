<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="stock_package_type_form" model="ir.ui.view">
        <field name="name">stock.package.type.form.provider.shipit</field>
        <field name="model">stock.package.type</field>
        <field name="inherit_id" ref="stock.stock_package_type_form" />
        <field name="arch" type="xml">
            <field name="shipper_package_code" position="before">
                <field name="shipit_is_carrier" invisible="1" />
                <field
                    name="shipit_package_type"
                    invisible="not shipit_is_carrier"
                    required="shipit_is_carrier"
                />
            </field>

            <field name="shipper_package_code" position="attributes">
                <attribute name="readonly">shipit_is_carrier</attribute>
                <attribute name="force_save">1</attribute>
            </field>

        </field>
    </record>

</odoo>
