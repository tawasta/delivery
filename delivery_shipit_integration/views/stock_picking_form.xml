<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_withcarrier_out_form_shipit" model="ir.ui.view">
        <field name="name">stock.picking.view.form.shipit.shipments</field>
        <field name="model">stock.picking</field>
        <field
            name="inherit_id"
            ref="stock_delivery.view_picking_withcarrier_out_form"
        />
        <field name="arch" type="xml">
            <field name="carrier_id" position="after">
                <field name="shipit_is_carrier" invisible="1" />
            </field>

            <button name="action_open_label_type" position="attributes">
                <attribute name="invisible">shipit_is_carrier</attribute>
            </button>

            <button name="action_open_label_type" position="after">
                <button
                    name="action_print_shipit_label"
                    string="Print shipit labels"
                    type="object"
                    invisible="not shipit_is_carrier or state != 'done'"
                />
            </button>

            <field name="picking_properties" position="attributes">
                <attribute name="invisible">shipit_is_carrier</attribute>
            </field>

            <button name="cancel_shipment" position="attributes">
                <attribute name="invisible">shipit_is_carrier</attribute>
            </button>
        </field>
    </record>
</odoo>
